// This source code is subject to the terms of the Mozilla Public License 2.0
// © ME Institutional — ME Scalp v3.0
//@version=6
indicator("ME Scalp v3.0", shorttitle="ME Scalp v3.0", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════════════════
// v3.0 — THE SAME ENGINE WITH TWO THIRDS OF IT DELETED.
// ─────────────────────────────────────────────────────────────────────────────
// Reported: "the indicator is complicated and terribly weak". Both fair. v2.5
// carried 32 inputs, six trigger families, three stop modes and a 400-line
// header, because I added to it eight times and removed nothing.
//
// Nothing here was cut for tidiness. Every deletion was measured first, on the
// same harness, 360 simulated days per timeframe. What came out and what it
// cost, each row removing one thing from the v2.5 engine:
//
//     5m                                    15m
//                        trd/d  TP1   SL      trd/d  TP1   SL
//     v2.5, all six       3.05  65%  11%       1.64  61%  23%
//     drop band/value     2.98  66%  11%       1.62  61%  23%   <- FREE
//     drop quality score  3.23  64%  11%       1.71  59%  22%   kept
//     drop leg alignment  3.41  63%  12%       1.83  59%  23%   kept
//
// THE VWAP BAND, VALUE-AREA AND BAND2 TRIGGERS ARE GONE. Removing all three
// costs nothing on either timeframe — 5m TP1 goes UP a point. They were 20% of
// the code and, after v2.4 gated the collapsed-band bug, close to none of the
// trades. Their removal takes the volume profile (POC/VAH/VAL), the VWAP
// deviation bands, the band-width input, the confirmation input (which only
// ever applied to those three families) and the location term of the quality
// score out with them.
//
// THE TP1 "SNAP TO STRUCTURE" IS GONE, and this one is worth stating plainly:
// IT NEVER FIRED. The rule pulled TP1 in to VWAP, the upper band or the POC
// when one sat nearer than the ATR target and at least 0.6 units away. Those
// two conditions leave a 0.2 ATR window, and no level lands in it. Measured
// with the rule on and off, with the fade triggers in and out — all four runs
// returned byte-identical trade counts and outcome mixes. It was dead code
// with a paragraph of documentation attached.
//
// THE QUALITY SCORE AND THE LEG ALIGNMENT STAY, because unlike the above they
// are not free: the score is worth about 2 points of TP1 for 8% of the trades,
// the alignment about 3 points for 14%. Note that the alignment survives on
// OUTCOME MIX. Its old expectancy justification was withdrawn and the inverted
// rule also measured ~0, so this is the first evidence it does anything.
//
// ALSO GONE: the v2.1 clamp stop mode and the R-target mode (one stop rule
// left, the structural one), i_maxRisk, i_minRisk, i_structMax and
// i_beAfterTp1 (constants now), and the split between i_slBuf and i_structPad,
// which were two inputs doing one job and adding.
//
//     33 inputs -> 16.    1230 lines -> 537.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT IT DOES, end to end, in one paragraph. Wait for a directional market
// (efficiency ratio over the threshold) and take one of three events in the
// direction of the leg: a break of the last pivot, a retest of a live fair
// value gap, or a sweep of a pivot that is immediately reclaimed. Each event
// carries its own invalidation level. The stop goes BEYOND that level plus a
// pad, never inside it. Targets are fixed ATR distances, deliberately not tied
// to the stop, so a wide stop does not make a slow trade. Take a third at each
// target, move to breakeven once the first fills, and close anything that has
// resolved nothing after twelve bars.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHERE IT STANDS AGAINST v2.3, WHERE THIS LINE OF WORK STARTED:
//
//              5m  trd/d  TP1  TP3   SL  TIME      15m  trd/d  TP1  TP3   SL  TIME
//     v2.3          4.92  57%  18%  14%   29%            3.13  45%  16%  26%   29%
//     v3.0          2.93  66%  22%  11%   22%            1.62  61%  23%  23%   16%
//
// (Those are the SHIPPED build, re-measured after the score lost its fifth
// term with the bands: 5m 2.98 -> 2.93 trades a day and nothing else moved,
// 15m identical to two decimals. The deletion cost nothing there either.)
//
// Better on every column except supply, which is down 40% and 48%. That is the
// trade this whole line of releases has been making, and it has no free side.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT THESE NUMBERS ARE NOT. They come from a synthetic price generator, not
// from gold. That generator once paid a naive momentum rule +0.21R, which is
// why every expectancy figure it ever produced was withdrawn. It can prove a
// rule is DEAD (the snap) or FREE (the fades) — those are geometry. It cannot
// tell you this makes money on XAUUSD at your broker. For that, run
// MEScalp.v2.5.strategy.pine in the Strategy Tester with your real commission
// and spread set in Properties. That number is the one that decides.
// ═══════════════════════════════════════════════════════════════════════════════


// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS — sixteen, down from thirty-three, and each one earns its place
// ═══════════════════════════════════════════════════════════════════════════════
var string G_ENG  = "══ Engine ══"
var string G_TRIG = "══ Triggers ══"
var string G_RISK = "══ Risk & Targets ══"
var string G_DISP = "══ Display ══"

i_freq = input.string("Standard", "Frequency", options=["Selective", "Standard", "High"], group=G_ENG,
     tooltip="How directional the market must be before the engine will trade — the efficiency-ratio threshold.\n\nSelective  ER >= 0.40\nStandard   ER >= 0.32\nHigh       ER >= 0.25\n\nThis is the supply dial. Every setting in this script trades supply for quality; none of them gives both.")
i_dir  = input.string("Both", "Direction", options=["Both", "Long only", "Short only"], group=G_ENG)
i_erLen = input.int(30, "Regime Lookback (bars)", minval=5, maxval=100, group=G_ENG,
     tooltip="Window for the efficiency ratio and for the direction of the leg being aligned to.\n\n30 rather than 20 on a user report that then measured out, and it is a PEAK, not a direction — 40 gives the gain back.\n\n  lookback  5m TP1  5m SL   15m TP1  15m SL\n  20           62%    12%       58%     25%\n  25           64%    11%       58%     25%\n  30           65%    11%       61%     23%\n  40           64%    12%       60%     23%\n\nIt costs about a quarter of the trades on 5m.")
i_score = input.int(1, "Quality Score Required (of 4)", minval=0, maxval=4, group=G_ENG,
     tooltip="Four independent readings of the entry bar: participation (volume >= 1.15x its 20-bar average), body >= 0.45 ATR, close in the leading third of the bar's range, and two or more triggers agreeing.\n\nMEASURED ON THIS BUILD:\n\n  need   5m trd/d  TP1  TP3   SL  TIME     15m trd/d  TP1  TP3   SL  TIME\n  0/4        3.23  64%  21%  11%   25%         1.71  59%  22%  22%   18%\n  1/4        2.93  66%  22%  11%   22%         1.62  61%  23%  23%   16%\n  2/4        2.03  72%  24%  13%   15%         1.36  66%  25%  26%    8%\n\nDropping it entirely costs about two points of reach and buys eight percent more trades. Small, real, and why it survived the cut.\n\nREAD THE SL COLUMN BEFORE RAISING IT. A stricter score does NOT reduce losses — it raises them, on both timeframes, while collapsing the share of trades that resolve nothing. It converts unresolved trades into resolved ones in BOTH directions at once. Going to 2/4 is a real choice: nine points more reach on 5m, two points more full stop-outs, and a third fewer trades.")

i_useMss   = input.bool(true, "MSS — break of the last pivot", group=G_TRIG,
     tooltip="Highest supply of the three and the only one whose invalidation is a PIVOT rather than a bar extreme, which is why it has its own stop pad.")
i_useFvg   = input.bool(true, "FVG retest", group=G_TRIG,
     tooltip="The best-behaved family on both timeframes: measured 5m TP1 64% / SL 19%, 15m TP1 66% / SL 9%. If you run only one trigger, run this one.")
i_useSweep = input.bool(true, "Liquidity sweep + reclaim", group=G_TRIG,
     tooltip="Rare — about 0.1 to 0.2 trades a day — and the highest reach of the three when it does fire (5m TP1 84%). Too few events for that to be more than suggestive.")

i_pad      = input.float(0.45, "Stop Clearance Beyond Invalidation (× ATR)", minval=0.0, maxval=2.0, step=0.05, group=G_RISK,
     tooltip="How far past the setup's own invalidation the stop sits.\n\nv2.5 and earlier split this across TWO inputs, i_slBuf (0.20) and i_structPad (0.25), which did the same job and ADDED — the clearance actually applied was always 0.45 and neither tooltip said so. One number now.\n\nMEASURED, on the wider engine: 0.25 -> 0.75 moved 5m stop-outs from 17% to 9% and 15m from 29% to 20%, with the trade count identical at every setting.\n\nTHE COST NO TABLE HERE SHOWS: position size divides by stop distance, so a wider stop means a smaller position for the same money at risk while the targets stay at fixed ATR distances. Every win pays less. Fewer stop-outs, smaller wins.")
i_breakPad = input.float(0.20, "Extra Clearance for MSS Breaks (× ATR)", minval=0.0, maxval=1.5, step=0.05, group=G_RISK,
     tooltip="Added to the clearance above, for MSS only.\n\nWHY ONLY MSS. FVG stops beyond a gap edge and a sweep stops beyond the bar's own extreme. MSS stops beyond the PIVOT it just broke, and on 15m that pivot is frequently a few ticks from the entry: measured 36% stop-outs against 9% for FVG, while being over half of all trades.\n\n  MSS pad    15m MSS SL   15m all SL   15m TP1\n  0.45 total      36%          28%        56%\n  0.65 total      32%          25%        58%   <- default\n  0.85 total      29%          23%        59%\n\nOn 5m the same change is neutral, so the default sits where 15m gains and 5m does not lose.")
i_tp1      = input.float(0.8, "TP1 (× ATR)", minval=0.2, maxval=5.0, step=0.1, group=G_RISK,
     tooltip="Reaching TP1 is what arms the breakeven move, so it is the target that decides whether a trade can still lose. A trade that never reaches it carries full risk for its whole life.\n\nMEASURED REACH (trades that ended BE or TP3, i.e. demonstrably got there):\n\n  TP1     5m reach   5m SL     15m reach   15m SL\n  0.40        77%      8%          61%      18%\n  0.50        72%      9%          57%      20%\n  0.80        59%     13%          48%      24%\n  1.00        52%     15%          42%      28%\n\nMonotone and real. Lower it to arm breakeven sooner and turn more losses into scratches; raise it for more per win and more full stops.")
i_tp2      = input.float(1.4, "TP2 (× ATR)", minval=0.3, maxval=8.0, step=0.1, group=G_RISK)
i_tp3      = input.float(2.0, "TP3 (× ATR)", minval=0.4, maxval=12.0, step=0.1, group=G_RISK,
     tooltip="Tested at 4R to let the last third run and measured no better than the 2R scale-out. That was a null result, so it stands as a rejection: no evidence the runner beats the scale-out here.")
i_timeStop = input.int(12, "Time Stop (bars, 0 = off)", minval=0, maxval=200, group=G_RISK,
     tooltip="Closes a trade that has resolved nothing after this many bars.\n\nTested at 18 on 5m: TP1 reach goes 62% -> 66% and the time-stop share 25% -> 19%, which looks like a clear gain and is not decidable here. Those six points come out as two more TP3, two more breakeven and two more full stop-outs, and what a time exit is worth — it closes at market, anywhere — is exactly what an outcome-mix harness cannot price.")

i_dash = input.bool(true, "Show dashboard", group=G_DISP)
i_font = input.string("Small", "Text Size", options=["Tiny", "Small", "Normal", "Large"], group=G_DISP)
i_keep = input.bool(true, "Keep completed plans on the chart", group=G_DISP,
     tooltip="Completed plans stay, frozen with their outcome, so the engine can be audited by scrolling back instead of trusted from a header. Through v2.4 each new setup deleted the previous one's drawings.")

fBody = i_font == "Large" ? size.large : i_font == "Normal" ? size.normal : i_font == "Small" ? size.small : size.tiny
fHead = i_font == "Large" ? size.huge : i_font == "Normal" ? size.large : i_font == "Small" ? size.normal : size.small

erMin      = i_freq == "High" ? 0.25 : i_freq == "Standard" ? 0.32 : 0.40
allowLong  = i_dir != "Short only"
allowShort = i_dir != "Long only"

// Fixed because they were inputs nobody should have to reason about, and the
// measurements never argued for moving them.
MIN_RISK   = 0.40      // stop floor, in ATR, so a stop cannot be absurdly tight
MAX_RISK   = 4.00      // reject a setup whose structural stop is wider than this
COOLDOWN   = 3         // bars between signals
BE_AFTER_1 = true      // breakeven once TP1 fills; this is the point of TP1


// ═══════════════════════════════════════════════════════════════════════════════
// CORE SERIES
// ═══════════════════════════════════════════════════════════════════════════════
atr      = ta.atr(14)
range_   = math.max(high - low, 1e-9)
closePos = (close - low) / range_
body     = math.abs(close - open)
conf     = barstate.isconfirmed

// Volume is absent on some FX/CFD feeds. Track whether it has ever been seen so
// the participation term self-neutralises instead of blocking forever.
var bool volSeen = false
if nz(volume) > 0
    volSeen := true
volAvg = ta.sma(nz(volume[1]), 20)
relVol = volSeen ? nz(volume) / math.max(volAvg, 1e-9) : 1.0

// REGIME — Kaufman efficiency ratio. Net movement over the window divided by the
// path travelled to get there. A straight leg scores near 1; the same range
// covered by thrashing scores near 0. Closed history only.
erNet    = math.abs(close - close[i_erLen])
erPath   = math.sum(math.abs(close - close[1]), i_erLen)
effRatio = erPath > 0 ? erNet / erPath : 0.0
legUp    = close > close[i_erLen]
inTrend  = effRatio >= erMin


// ═══════════════════════════════════════════════════════════════════════════════
// STRUCTURE — pivots for MSS and for the sweep
// ═══════════════════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, 2, 2)
pl = ta.pivotlow(low, 2, 2)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

sph = ta.pivothigh(high, 5, 5)
spl = ta.pivotlow(low, 5, 5)
var float sweepHi = na
var float sweepLo = na
if not na(sph)
    sweepHi := sph
if not na(spl)
    sweepLo := spl


// ═══════════════════════════════════════════════════════════════════════════════
// FAIR VALUE GAPS — a store of live gaps, each expiring by age or by being filled
// ═══════════════════════════════════════════════════════════════════════════════
var array<float> gapBullTop = array.new_float()
var array<float> gapBullBot = array.new_float()
var array<int>   gapBullBar = array.new_int()
var array<float> gapBearTop = array.new_float()
var array<float> gapBearBot = array.new_float()
var array<int>   gapBearBar = array.new_int()

if conf
    // A bullish gap is the space between the high two bars back and this low.
    if low > high[2] and (low - high[2]) >= atr * 0.10
        array.push(gapBullTop, low)
        array.push(gapBullBot, high[2])
        array.push(gapBullBar, bar_index)
    if high < low[2] and (low[2] - high) >= atr * 0.10
        array.push(gapBearTop, low[2])
        array.push(gapBearBot, high)
        array.push(gapBearBar, bar_index)
    // Expire: filled through, or older than 60 bars.
    if array.size(gapBullBar) > 0
        for k = array.size(gapBullBar) - 1 to 0
            if close < array.get(gapBullBot, k) or bar_index - array.get(gapBullBar, k) > 60
                array.remove(gapBullTop, k)
                array.remove(gapBullBot, k)
                array.remove(gapBullBar, k)
    if array.size(gapBearBar) > 0
        for k = array.size(gapBearBar) - 1 to 0
            if close > array.get(gapBearTop, k) or bar_index - array.get(gapBearBar, k) > 60
                array.remove(gapBearTop, k)
                array.remove(gapBearBot, k)
                array.remove(gapBearBar, k)


// ═══════════════════════════════════════════════════════════════════════════════
// TRIGGERS — three events, each carrying the level that would prove it wrong
// ─────────────────────────────────────────────────────────────────────────────
// The invalidation is what the stop is built from, so each setup is stopped
// beyond the thing that disproves it rather than at a fixed ATR guess.
// ═══════════════════════════════════════════════════════════════════════════════
// 1 MSS — price closes through the last short-term pivot
mssBull = conf and i_useMss and not na(lastPH) and close >= lastPH + atr * 0.08 and close[1] < lastPH
mssBear = conf and i_useMss and not na(lastPL) and close <= lastPL - atr * 0.08 and close[1] > lastPL

// 2 FVG retest — price trades into a live gap and closes back out of it
fvgBull = false
float fvgBullInv = na
if conf and i_useFvg and array.size(gapBullBar) > 0
    for k = array.size(gapBullBar) - 1 to 0
        if low <= array.get(gapBullTop, k) and close >= array.get(gapBullBot, k) and closePos >= 0.55
            fvgBull := true
            fvgBullInv := array.get(gapBullBot, k)
            break
fvgBear = false
float fvgBearInv = na
if conf and i_useFvg and array.size(gapBearBar) > 0
    for k = array.size(gapBearBar) - 1 to 0
        if high >= array.get(gapBearBot, k) and close <= array.get(gapBearTop, k) and closePos <= 0.45
            fvgBear := true
            fvgBearInv := array.get(gapBearTop, k)
            break

// 3 Liquidity sweep — a pivot taken out by a wick and immediately reclaimed
swBull = conf and i_useSweep and not na(sweepLo) and (sweepLo - low) >= atr * 0.35 and close > sweepLo and closePos >= 0.55
swBear = conf and i_useSweep and not na(sweepHi) and (high - sweepHi) >= atr * 0.35 and close < sweepHi and closePos <= 0.45

nBull = (mssBull ? 1 : 0) + (fvgBull ? 1 : 0) + (swBull ? 1 : 0)
nBear = (mssBear ? 1 : 0) + (fvgBear ? 1 : 0) + (swBear ? 1 : 0)

// Priority when more than one fires. Not cosmetic: it selects the INVALIDATION
// the stop is built from, so it changes the trade.
bullName = mssBull ? "MSS" : fvgBull ? "FVG" : "SWEEP"
bearName = mssBear ? "MSS" : fvgBear ? "FVG" : "SWEEP"
bullInval = mssBull ? (na(lastPL) ? low : lastPL) : fvgBull ? fvgBullInv : low
bearInval = mssBear ? (na(lastPH) ? high : lastPH) : fvgBear ? fvgBearInv : high


// ═══════════════════════════════════════════════════════════════════════════════
// QUALITY SCORE, 0-4 — four independent readings of the entry bar
// ─────────────────────────────────────────────────────────────────────────────
// v2.5 had a fifth, "location at a VWAP band". It went with the bands.
// ═══════════════════════════════════════════════════════════════════════════════
sPart  = relVol >= 1.15 ? 1 : 0
sBody  = body >= atr * 0.45 ? 1 : 0
scoreBull = sPart + sBody + (closePos >= 0.65 ? 1 : 0) + (nBull >= 2 ? 1 : 0)
scoreBear = sPart + sBody + (closePos <= 0.35 ? 1 : 0) + (nBear >= 2 ? 1 : 0)


// ═══════════════════════════════════════════════════════════════════════════════
// THE STOP — beyond the invalidation, never inside it
// ─────────────────────────────────────────────────────────────────────────────
// A setup whose structural stop is genuinely too wide is DECLINED. It is never
// squeezed into a cap: squeezing produces a stop that no longer marks
// invalidation, so ordinary price action returning to structure closes a trade
// whose idea is still intact. Measured on the v2.1 build that did squeeze: 86%
// of stops were clamped, landing a median 1.10 ATR inside the level, and 91% of
// the resulting stop-outs happened without the level ever being breached.
// ═══════════════════════════════════════════════════════════════════════════════
padBull = atr * (i_pad + (bullName == "MSS" ? i_breakPad : 0.0))
padBear = atr * (i_pad + (bearName == "MSS" ? i_breakPad : 0.0))
slBull  = math.min(bullInval, close - atr * MIN_RISK) - padBull
slBear  = math.max(bearInval, close + atr * MIN_RISK) + padBear
riskBull = close - slBull
riskBear = slBear - close
riskOkBull = riskBull >= atr * MIN_RISK * 0.5 and riskBull <= atr * MAX_RISK
riskOkBear = riskBear >= atr * MIN_RISK * 0.5 and riskBear <= atr * MAX_RISK

// Targets are ATR distances, deliberately NOT multiples of the stop. That is
// what keeps a structure-respecting stop from making a slow trade: the targets
// stay where they were in PRICE while only the stop moves out.
buyTp1  = close + atr * i_tp1
buyTp2  = close + atr * i_tp2
buyTp3  = close + atr * i_tp3
sellTp1 = close - atr * i_tp1
sellTp2 = close - atr * i_tp2
sellTp3 = close - atr * i_tp3


// ═══════════════════════════════════════════════════════════════════════════════
// SIGNAL
// ═══════════════════════════════════════════════════════════════════════════════
var int lastSigBar = -100000
coolOk = bar_index - lastSigBar >= COOLDOWN
buySignal  = nBull > 0 and allowLong  and close > open and coolOk and riskOkBull and scoreBull >= i_score and inTrend and legUp
sellSignal = nBear > 0 and allowShort and close < open and coolOk and riskOkBear and scoreBear >= i_score and inTrend and not legUp


// ═══════════════════════════════════════════════════════════════════════════════
// TRADE STATE — one plan at a time, and ALL THREE targets are tracked
// ─────────────────────────────────────────────────────────────────────────────
// Through v2.4, TP2 was drawn and never tested anywhere in the engine, so a
// trade that ran through TP1 and TP2 and came back was stamped "BE" — a
// scratch — while two of three legs had paid.
// ═══════════════════════════════════════════════════════════════════════════════
var bool   inTrade  = false
var bool   tradeBuy = false
var float  eEntry   = na
var float  eSl      = na
var float  eT1      = na
var float  eT2      = na
var float  eT3      = na
var int    eBar     = na
var bool   eTp1     = false
var bool   eTp2     = false
var string eName    = ""
var int    nTrades  = 0
var int    nTp1     = 0
var int    nTp2     = 0
var int    nWin     = 0
var int    nLoss    = 0
var int    tp1Bar   = na
var int    tp2Bar   = na

fired = (buySignal or sellSignal) and not inTrade
if fired
    inTrade  := true
    tradeBuy := buySignal
    eEntry   := close
    eSl      := buySignal ? slBull : slBear
    eT1      := buySignal ? buyTp1 : sellTp1
    eT2      := buySignal ? buyTp2 : sellTp2
    eT3      := buySignal ? buyTp3 : sellTp3
    eBar     := bar_index
    eTp1     := false
    eTp2     := false
    eName    := buySignal ? bullName : bearName
    lastSigBar := bar_index
    nTrades  := nTrades + 1

// Resolution on confirmed bars only. The stop is tested FIRST, so a bar that
// spans both the stop and a target is never scored as a win.
slHit  = false
tpHit  = false
timeUp = false
if inTrade and conf and bar_index > eBar
    slHit := tradeBuy ? low <= eSl : high >= eSl
    if not eTp1
        bool t1 = tradeBuy ? high >= eT1 : low <= eT1
        if t1 and not slHit
            eTp1   := true
            tp1Bar := bar_index
            nTp1   := nTp1 + 1
            if BE_AFTER_1
                eSl := eEntry
    if not eTp2
        bool t2 = tradeBuy ? high >= eT2 : low <= eT2
        if t2 and not slHit
            eTp2   := true
            tp2Bar := bar_index
            nTp2   := nTp2 + 1
    tpHit  := tradeBuy ? high >= eT3 : low <= eT3
    timeUp := i_timeStop > 0 and (bar_index - eBar) >= i_timeStop

justClosed = inTrade and (slHit or tpHit or timeUp)
// Say HOW FAR it got. "BE" and "TIME" both used to conceal a trade that had
// banked one or two legs.
legTxt   = eTp2 ? "TP2 ✓ " : eTp1 ? "TP1 ✓ " : ""
closeTxt = tpHit ? "TP3 ✓" : slHit ? (eTp1 ? legTxt + "→ BE" : "SL ✕") : legTxt + "TIME"
closeCol = tpHit ? color.new(#00E676, 0) : slHit and eTp1 ? color.new(#FFC400, 0) : slHit ? color.new(#FF1744, 0) : color.new(#888888, 0)
if justClosed
    if tpHit or (slHit and eTp1)
        nWin := nWin + 1
    else if slHit
        nLoss := nLoss + 1
    inTrade := false


// ═══════════════════════════════════════════════════════════════════════════════
// PLOTTING
// ═══════════════════════════════════════════════════════════════════════════════
plotshape(not na(tp1Bar) and tp1Bar == bar_index and tradeBuy,      "TP1 hit (long)",  shape.triangleup,   location.belowbar, color.new(#00E676, 30), size=size.tiny)
plotshape(not na(tp1Bar) and tp1Bar == bar_index and not tradeBuy,  "TP1 hit (short)", shape.triangledown, location.abovebar, color.new(#00E676, 30), size=size.tiny)
plotshape(not na(tp2Bar) and tp2Bar == bar_index and tradeBuy,      "TP2 hit (long)",  shape.triangleup,   location.belowbar, color.new(#00E676, 0),  size=size.tiny)
plotshape(not na(tp2Bar) and tp2Bar == bar_index and not tradeBuy,  "TP2 hit (short)", shape.triangledown, location.abovebar, color.new(#00E676, 0),  size=size.tiny)
plotshape(buySignal  and not inTrade[1], "BUY",  shape.labelup,   location.belowbar, color.new(#00E676, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(sellSignal and not inTrade[1], "SELL", shape.labeldown, location.abovebar, color.new(#FF1744, 0), text="SELL", textcolor=color.white, size=size.small)
bgcolor(inTrend ? color.new(legUp ? #00E676 : #FF1744, 94) : na, title="Regime")

// ── the plan. Drawn from its entry bar, extended while live, frozen and stamped
// on the bar that closed it. The ENTRY line is drawn too, which v2.4 and earlier
// never did — so the stop and targets had no reference point and the move to
// breakeven was invisible.
var line  lnEn = na
var line  lnSl = na
var line  lnT1 = na
var line  lnT2 = na
var line  lnT3 = na
var label lbEn = na
var label lbSl = na
var label lbT1 = na
var label lbT2 = na
var label lbT3 = na
var label lbEnd = na

if fired
    if not na(lnSl) and not i_keep
        line.delete(lnEn)
        line.delete(lnSl)
        line.delete(lnT1)
        line.delete(lnT2)
        line.delete(lnT3)
        label.delete(lbEn)
        label.delete(lbSl)
        label.delete(lbT1)
        label.delete(lbT2)
        label.delete(lbT3)
        label.delete(lbEnd)
    lnEn := line.new(bar_index, eEntry, bar_index, eEntry, color=color.new(#FFFFFF, 25), style=line.style_dotted)
    lnSl := line.new(bar_index, eSl, bar_index, eSl, color=color.new(#FF1744, 0), width=2)
    lnT1 := line.new(bar_index, eT1, bar_index, eT1, color=color.new(#00E676, 20), style=line.style_dashed)
    lnT2 := line.new(bar_index, eT2, bar_index, eT2, color=color.new(#00E676, 40), style=line.style_dashed)
    lnT3 := line.new(bar_index, eT3, bar_index, eT3, color=color.new(#00E676, 60), style=line.style_dashed)
    lbEn := label.new(bar_index, eEntry, "ENTRY " + str.tostring(eEntry, format.mintick), style=label.style_label_left, color=color.new(#000000, 100), textcolor=color.new(#FFFFFF, 0), size=fBody)
    lbSl := label.new(bar_index, eSl, "SL " + str.tostring(eSl, format.mintick), style=label.style_label_left, color=color.new(#000000, 100), textcolor=color.new(#FF1744, 0), size=fBody)
    lbT1 := label.new(bar_index, eT1, "TP1 " + str.tostring(eT1, format.mintick), style=label.style_label_left, color=color.new(#000000, 100), textcolor=color.new(#00E676, 0), size=fBody)
    lbT2 := label.new(bar_index, eT2, "TP2 " + str.tostring(eT2, format.mintick), style=label.style_label_left, color=color.new(#000000, 100), textcolor=color.new(#00E676, 20), size=fBody)
    lbT3 := label.new(bar_index, eT3, "TP3 " + str.tostring(eT3, format.mintick), style=label.style_label_left, color=color.new(#000000, 100), textcolor=color.new(#00E676, 40), size=fBody)

if inTrade and not na(lnSl)
    line.set_x2(lnEn, bar_index)
    line.set_x2(lnSl, bar_index)
    line.set_x2(lnT1, bar_index)
    line.set_x2(lnT2, bar_index)
    line.set_x2(lnT3, bar_index)
    line.set_y1(lnSl, eSl)
    line.set_y2(lnSl, eSl)
    label.set_x(lbEn, bar_index)
    label.set_x(lbSl, bar_index)
    label.set_y(lbSl, eSl)
    label.set_text(lbSl, (eTp1 ? "BE " : "SL ") + str.tostring(eSl, format.mintick))
    if eTp1
        label.set_text(lbT1, "TP1 ✓ " + str.tostring(eT1, format.mintick))
    if eTp2
        label.set_text(lbT2, "TP2 ✓ " + str.tostring(eT2, format.mintick))
    label.set_x(lbT1, bar_index)
    label.set_x(lbT2, bar_index)
    label.set_x(lbT3, bar_index)

if justClosed and not na(lnSl)
    line.set_x2(lnEn, bar_index)
    line.set_x2(lnSl, bar_index)
    line.set_x2(lnT1, bar_index)
    line.set_x2(lnT2, bar_index)
    line.set_x2(lnT3, bar_index)
    lbEnd := label.new(bar_index, tradeBuy ? low : high, closeTxt,
         style=tradeBuy ? label.style_label_up : label.style_label_down,
         color=color.new(#000000, 100), textcolor=closeCol, size=fBody)


// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD — eight rows, and every number on it decides a trade
// ═══════════════════════════════════════════════════════════════════════════════
var table dash = na
if i_dash and barstate.islast
    if na(dash)
        dash := table.new(position.top_right, 3, 8, bgcolor=color.rgb(10, 10, 15, 5), border_width=1, border_color=color.rgb(40, 40, 50))
    grn = color.new(#00E676, 0)
    red = color.new(#FF1744, 0)
    dim = color.new(#888888, 0)
    yel = color.new(#FFC400, 0)
    wht = color.new(#FFFFFF, 0)
    hdr = color.rgb(14, 14, 20)

    table.cell(dash, 0, 0, "ME SCALP v3.0 — " + str.upper(i_freq), text_color=wht, bgcolor=color.rgb(15, 15, 20), text_size=fHead, text_halign=text.align_left)
    table.cell(dash, 1, 0, "", bgcolor=color.rgb(15, 15, 20))
    table.cell(dash, 2, 0, "", bgcolor=color.rgb(15, 15, 20))

    table.cell(dash, 0, 1, "", text_size=fBody, bgcolor=hdr)
    table.cell(dash, 1, 1, "BUY",  text_color=grn, text_size=fBody, bgcolor=hdr)
    table.cell(dash, 2, 1, "SELL", text_color=red, text_size=fBody, bgcolor=hdr)

    // If this says CHOP the engine is deliberately standing aside.
    table.cell(dash, 0, 2, "Regime (ER≥" + str.tostring(erMin, "#.00") + ")", text_color=dim, text_size=fBody, text_halign=text.align_left, bgcolor=hdr)
    table.cell(dash, 1, 2, (inTrend ? (legUp ? "TREND ▲" : "TREND ▼") : "CHOP") + "  " + str.tostring(math.round(effRatio, 2)), text_color=inTrend ? (legUp ? grn : red) : yel, text_size=fBody)
    table.cell(dash, 2, 2, inTrend ? (legUp ? "longs only" : "shorts only") : "standing aside", text_color=dim, text_size=fBody)

    table.cell(dash, 0, 3, "Trigger", text_color=dim, text_size=fBody, text_halign=text.align_left, bgcolor=hdr)
    table.cell(dash, 1, 3, nBull > 0 ? bullName + " ×" + str.tostring(nBull) : "—", text_color=nBull > 0 ? grn : dim, text_size=fBody)
    table.cell(dash, 2, 3, nBear > 0 ? bearName + " ×" + str.tostring(nBear) : "—", text_color=nBear > 0 ? red : dim, text_size=fBody)

    table.cell(dash, 0, 4, "Score (need " + str.tostring(i_score) + "/4)", text_color=dim, text_size=fBody, text_halign=text.align_left, bgcolor=hdr)
    table.cell(dash, 1, 4, str.tostring(scoreBull) + "/4", text_color=scoreBull >= i_score ? grn : dim, text_size=fBody)
    table.cell(dash, 2, 4, str.tostring(scoreBear) + "/4", text_color=scoreBear >= i_score ? red : dim, text_size=fBody)

    table.cell(dash, 0, 5, "Risk (× ATR)", text_color=dim, text_size=fBody, text_halign=text.align_left, bgcolor=hdr)
    table.cell(dash, 1, 5, str.tostring(math.round(riskBull / math.max(atr, 1e-9), 2)), text_color=riskOkBull ? grn : dim, text_size=fBody)
    table.cell(dash, 2, 5, str.tostring(math.round(riskBear / math.max(atr, 1e-9), 2)), text_color=riskOkBear ? red : dim, text_size=fBody)

    table.cell(dash, 0, 6, "Open trade", text_color=dim, text_size=fBody, text_halign=text.align_left, bgcolor=color.rgb(15, 15, 22))
    table.cell(dash, 1, 6, inTrade ? (tradeBuy ? "LONG " : "SHORT ") + eName + "  " + str.tostring(bar_index - eBar) + "b" + (eTp1 ? "  BE" : "") : "flat", text_color=inTrade ? (tradeBuy ? grn : red) : dim, text_size=fBody)
    table.cell(dash, 2, 6, inTrade and i_timeStop > 0 ? "close in " + str.tostring(math.max(i_timeStop - (bar_index - eBar), 0)) + "b" : "", text_color=dim, text_size=fBody)

    // Counted on YOUR symbol, which outranks anything my generator produced.
    table.cell(dash, 0, 7, "TP1 / TP2 reach", text_color=dim, text_size=fBody, text_halign=text.align_left, bgcolor=color.rgb(15, 15, 22))
    table.cell(dash, 1, 7, nTrades > 0 ? str.tostring(math.round(100.0 * nTp1 / nTrades)) + "% / " + str.tostring(math.round(100.0 * nTp2 / nTrades)) + "%" : "—", text_color=nTrades == 0 ? dim : (nTp1 * 2 >= nTrades ? grn : yel), text_size=fBody)
    table.cell(dash, 2, 7, str.tostring(nTrades) + " trades" + (nWin + nLoss > 0 ? "  " + str.tostring(math.round(100.0 * nWin / (nWin + nLoss))) + "% win" : ""), text_color=wht, text_size=fBody)


// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════
if buySignal and not inTrade[1]
    alert("ME Scalp BUY " + bullName + " | entry " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slBull, format.mintick) + " | TP " + str.tostring(buyTp1, format.mintick) + " / " + str.tostring(buyTp2, format.mintick) + " / " + str.tostring(buyTp3, format.mintick), alert.freq_once_per_bar_close)
if sellSignal and not inTrade[1]
    alert("ME Scalp SELL " + bearName + " | entry " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slBear, format.mintick) + " | TP " + str.tostring(sellTp1, format.mintick) + " / " + str.tostring(sellTp2, format.mintick) + " / " + str.tostring(sellTp3, format.mintick), alert.freq_once_per_bar_close)

alertcondition(buySignal,  "ME Scalp — BUY",  "ME Scalp BUY")
alertcondition(sellSignal, "ME Scalp — SELL", "ME Scalp SELL")
