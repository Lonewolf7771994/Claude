// This Pine Script is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// XAUUSD Order Block + Order Flow + FRVP Entry System
// Designed for OANDA:XAUUSD - All Timeframes
// Modes: Swing | Scalp | Intraday | Sniper

//@version=6
indicator("XAUUSD OB + OrderFlow + FRVP", shorttitle="OB-OF-FRVP", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =============================================
// INPUTS
// =============================================

// --- Mode ---
tradeMode    = input.string("Swing", "Trading Mode", options=["Swing", "Scalp", "Intraday", "Sniper"], group="Mode", tooltip="Swing: HTF confluence, wider stops. Scalp: Fast entries, tight stops. Intraday: Session-based. Sniper: Triple confluence only.")

// --- Order Blocks ---
obLength     = input.int(5, "OB Detection Lookback", minval=2, maxval=50, group="Order Blocks")
obMitigate   = input.bool(true, "Show Only Unmitigated OBs", group="Order Blocks")
obMaxAge     = input.int(100, "Max OB Age (bars)", minval=10, maxval=500, group="Order Blocks")
obShowBull   = input.bool(true, "Show Bullish OBs", group="Order Blocks")
obShowBear   = input.bool(true, "Show Bearish OBs", group="Order Blocks")
obRefine     = input.bool(true, "Refine OB to Wick (Sniper)", group="Order Blocks")

// --- Order Flow ---
ofEnabled    = input.bool(true, "Enable Order Flow", group="Order Flow")
ofDelta      = input.int(14, "Delta Period", minval=5, maxval=50, group="Order Flow")
ofAbsorb     = input.float(2.0, "Absorption Threshold", minval=1.0, maxval=5.0, step=0.1, group="Order Flow")
ofImbalance  = input.float(3.0, "Imbalance Ratio", minval=1.5, maxval=10.0, step=0.5, group="Order Flow")

// --- FRVP ---
frvpEnabled  = input.bool(true, "Enable FRVP", group="FRVP")
frvpLen      = input.int(50, "FRVP Lookback Bars", minval=10, maxval=300, group="FRVP")
frvpRows     = input.int(40, "FRVP Row Count", minval=10, maxval=100, group="FRVP")
frvpPocWidth = input.int(3, "POC Line Width", minval=1, maxval=5, group="FRVP")
frvpShowVA   = input.bool(true, "Show Value Area", group="FRVP")
frvpVAPct    = input.float(70.0, "Value Area %", minval=50.0, maxval=90.0, step=5.0, group="FRVP")

// --- Structure ---
structLen    = input.int(5, "Structure Pivot Length", minval=2, maxval=20, group="Structure")
showBOS      = input.bool(true, "Show BOS", group="Structure")
showCHoCH    = input.bool(true, "Show CHoCH", group="Structure")

// --- Entry Signals ---
showEntries  = input.bool(true, "Show Entry Signals", group="Entries")
showTP       = input.bool(true, "Show TP Levels", group="Entries")
showSL       = input.bool(true, "Show SL Levels", group="Entries")
riskReward   = input.float(3.0, "Risk:Reward Ratio", minval=1.0, maxval=10.0, step=0.5, group="Entries")
atrMult      = input.float(1.5, "ATR Multiplier for SL", minval=0.5, maxval=5.0, step=0.1, group="Entries")

// --- Sessions ---
sessFilter   = input.bool(false, "Enable Session Filter", group="Sessions")
sessLondon   = input.bool(true, "London (03:00-12:00 ET)", group="Sessions")
sessNY       = input.bool(true, "New York (08:00-17:00 ET)", group="Sessions")
sessAsia     = input.bool(false, "Asia (19:00-04:00 ET)", group="Sessions")

// --- Colors ---
bullOBColor  = input.color(color.new(color.green, 75), "Bullish OB", group="Colors")
bearOBColor  = input.color(color.new(color.red, 75), "Bearish OB", group="Colors")
pocColor     = input.color(color.yellow, "POC", group="Colors")
vaColor      = input.color(color.new(color.blue, 85), "Value Area", group="Colors")
entryBullCol = input.color(color.green, "Bull Entry", group="Colors")
entryBearCol = input.color(color.red, "Bear Entry", group="Colors")

// =============================================
// MODE-ADAPTIVE PARAMETERS
// =============================================

modeATRLen  = tradeMode == "Swing" ? 20 : tradeMode == "Scalp" ? 7 : tradeMode == "Intraday" ? 14 : 10
modeSLMult  = tradeMode == "Swing" ? atrMult * 1.5 : tradeMode == "Scalp" ? atrMult * 0.6 : tradeMode == "Intraday" ? atrMult : atrMult * 0.4
modeRR      = tradeMode == "Swing" ? riskReward : tradeMode == "Scalp" ? math.max(riskReward * 0.5, 1.5) : tradeMode == "Intraday" ? riskReward * 0.75 : riskReward * 1.5
modeOBLen   = tradeMode == "Swing" ? obLength * 2 : tradeMode == "Intraday" ? int(math.round(obLength * 1.5)) : obLength
modeConfReq = tradeMode == "Sniper" ? 3 : tradeMode == "Scalp" ? 1 : 2

// =============================================
// SESSION FILTER
// =============================================

hourET    = hour + minute / 60.0
inLondon  = hourET >= 3.0 and hourET < 12.0
inNY      = hourET >= 8.0 and hourET < 17.0
inAsia    = hourET >= 19.0 or hourET < 4.0
sessionOK = not sessFilter or (sessLondon and inLondon) or (sessNY and inNY) or (sessAsia and inAsia)

// =============================================
// ATR
// =============================================

atrVal = ta.atr(modeATRLen)

// =============================================
// MARKET STRUCTURE - BOS & CHoCH
// =============================================

pivHi = ta.pivothigh(high, structLen, structLen)
pivLo = ta.pivotlow(low, structLen, structLen)

var float lastHH = na
var float lastLL = na
var float lastLH = na
var float lastHL = na
var int   msTrend = 0

if not na(pivHi)
    if pivHi > nz(lastHH, pivHi)
        if msTrend == -1 and showCHoCH
            label.new(bar_index - structLen, pivHi, "CHoCH", style=label.style_label_down, color=entryBullCol, textcolor=color.white, size=size.tiny)
        lastHH  := pivHi
        msTrend := 1
    else
        lastLH := pivHi

if not na(pivLo)
    if pivLo < nz(lastLL, pivLo)
        if msTrend == 1 and showCHoCH
            label.new(bar_index - structLen, pivLo, "CHoCH", style=label.style_label_up, color=entryBearCol, textcolor=color.white, size=size.tiny)
        lastLL  := pivLo
        msTrend := -1
    else
        lastHL := pivLo

if not na(pivHi) and pivHi > nz(lastHH, pivHi) and msTrend == 1 and showBOS
    label.new(bar_index - structLen, pivHi, "BOS", style=label.style_label_down, color=color.new(entryBullCol, 50), textcolor=color.white, size=size.tiny)

if not na(pivLo) and pivLo < nz(lastLL, pivLo) and msTrend == -1 and showBOS
    label.new(bar_index - structLen, pivLo, "BOS", style=label.style_label_up, color=color.new(entryBearCol, 50), textcolor=color.white, size=size.tiny)

// =============================================
// ORDER BLOCKS - using parallel arrays
// =============================================

var array<float> obTops      = array.new_float(0)
var array<float> obBottoms   = array.new_float(0)
var array<int>   obBars      = array.new_int(0)
var array<bool>  obIsBull    = array.new_bool(0)
var array<box>   obBoxes     = array.new_box(0)

avgBody = ta.sma(math.abs(close - open), 20)

bullOBFound = false
bearOBFound = false
bullTop = 0.0
bullBot = 0.0
bearTop = 0.0
bearBot = 0.0

for i = 1 to modeOBLen
    if not bullOBFound
        isBullCandle = close[i] > open[i]
        isBearPrev   = close[i + 1] < open[i + 1]
        engulfs      = close[i] > high[i + 1]
        bodySize     = math.abs(close[i] - open[i])
        isStrong     = bodySize > avgBody * 1.5
        if isBullCandle and isBearPrev and engulfs and isStrong
            bullOBFound := true
            if obRefine and tradeMode == "Sniper"
                bullBot := low[i + 1]
                bullTop := math.min(open[i + 1], close[i + 1])
            else
                bullBot := low[i + 1]
                bullTop := high[i + 1]

for i = 1 to modeOBLen
    if not bearOBFound
        isBearCandle = close[i] < open[i]
        isBullPrev   = close[i + 1] > open[i + 1]
        engulfs      = close[i] < low[i + 1]
        bodySize     = math.abs(close[i] - open[i])
        isStrong     = bodySize > avgBody * 1.5
        if isBearCandle and isBullPrev and engulfs and isStrong
            bearOBFound := true
            if obRefine and tradeMode == "Sniper"
                bearTop := high[i + 1]
                bearBot := math.max(open[i + 1], close[i + 1])
            else
                bearTop := high[i + 1]
                bearBot := low[i + 1]

if bullOBFound and obShowBull
    newBox = box.new(bar_index - modeOBLen, bullTop, bar_index + 20, bullBot, border_color=color.new(entryBullCol, 60), bgcolor=bullOBColor, border_width=1)
    array.push(obTops, bullTop)
    array.push(obBottoms, bullBot)
    array.push(obBars, bar_index)
    array.push(obIsBull, true)
    array.push(obBoxes, newBox)

if bearOBFound and obShowBear
    newBox = box.new(bar_index - modeOBLen, bearTop, bar_index + 20, bearBot, border_color=color.new(entryBearCol, 60), bgcolor=bearOBColor, border_width=1)
    array.push(obTops, bearTop)
    array.push(obBottoms, bearBot)
    array.push(obBars, bar_index)
    array.push(obIsBull, false)
    array.push(obBoxes, newBox)

// --- Mitigate & extend OBs ---
if array.size(obTops) > 0
    for i = array.size(obTops) - 1 to 0
        obTopVal  = array.get(obTops, i)
        obBotVal  = array.get(obBottoms, i)
        obBarVal  = array.get(obBars, i)
        obBullVal = array.get(obIsBull, i)
        age       = bar_index - obBarVal
        mitigated = false
        if age > obMaxAge
            mitigated := true
        if obBullVal and close < obBotVal
            mitigated := true
        if not obBullVal and close > obTopVal
            mitigated := true
        if mitigated and obMitigate
            box.delete(array.get(obBoxes, i))
            array.remove(obTops, i)
            array.remove(obBottoms, i)
            array.remove(obBars, i)
            array.remove(obIsBull, i)
            array.remove(obBoxes, i)
        else if not mitigated
            box.set_right(array.get(obBoxes, i), bar_index + 5)

// =============================================
// ORDER FLOW ANALYSIS
// =============================================

spread   = high - low
safeDiv  = math.max(spread, syminfo.mintick)
bullVol  = close >= open ? volume : volume * math.max(close - low, 0.0) / safeDiv
bearVol  = close <= open ? volume : volume * math.max(high - close, 0.0) / safeDiv
delta    = bullVol - bearVol
deltaMA  = ta.sma(delta, ofDelta)
avgVol   = ta.sma(volume, ofDelta)

deltaDivBull = close < close[1] and delta > deltaMA and delta > 0
deltaDivBear = close > close[1] and delta < -deltaMA and delta < 0
absorption   = not na(atrVal) and volume > avgVol * ofAbsorb and math.abs(close - open) < atrVal * 0.3
stackedBull  = bullVol > bearVol * ofImbalance and bullVol[1] > bearVol[1] * ofImbalance
stackedBear  = bearVol > bullVol * ofImbalance and bearVol[1] > bullVol[1] * ofImbalance

ofBullish = ofEnabled and (deltaDivBull or (absorption and close > open) or stackedBull)
ofBearish = ofEnabled and (deltaDivBear or (absorption and close < open) or stackedBear)

// =============================================
// FRVP (Fixed Range Volume Profile)
// =============================================

var float pocLevel = na
var float vaHigh   = na
var float vaLow    = na
var array<float> volProfile = array.new_float(0)

if frvpEnabled and bar_index > frvpLen
    rangeHi   = ta.highest(high, frvpLen)
    rangeLo   = ta.lowest(low, frvpLen)
    rangeSize = rangeHi - rangeLo

    if rangeSize > syminfo.mintick
        rowHeight = rangeSize / frvpRows

        array.clear(volProfile)
        for r = 0 to frvpRows - 1
            array.push(volProfile, 0.0)

        for j = 0 to frvpLen - 1
            bSpread  = math.max(high[j] - low[j], syminfo.mintick)
            rowsHit  = math.max(1, int(math.round(bSpread / rowHeight)))
            bVol     = volume[j] / rowsHit
            sRow     = int(math.max(0.0, math.floor((low[j] - rangeLo) / rowHeight)))
            eRow     = int(math.min(frvpRows - 1.0, math.floor((high[j] - rangeLo) / rowHeight)))
            if sRow <= eRow and sRow >= 0 and eRow < frvpRows
                for r = sRow to eRow
                    array.set(volProfile, r, array.get(volProfile, r) + bVol)

        maxVol = 0.0
        pocIdx = 0
        for r = 0 to frvpRows - 1
            v = array.get(volProfile, r)
            if v > maxVol
                maxVol := v
                pocIdx := r

        pocLevel := rangeLo + (pocIdx + 0.5) * rowHeight

        totalVol = 0.0
        for r = 0 to frvpRows - 1
            totalVol += array.get(volProfile, r)

        vaTarget = totalVol * frvpVAPct / 100.0
        vaVol    = array.get(volProfile, pocIdx)
        vaLIdx   = pocIdx
        vaHIdx   = pocIdx

        cnt = 0
        while vaVol < vaTarget and (vaLIdx > 0 or vaHIdx < frvpRows - 1) and cnt < frvpRows
            cnt += 1
            addL = vaLIdx > 0 ? array.get(volProfile, vaLIdx - 1) : 0.0
            addH = vaHIdx < frvpRows - 1 ? array.get(volProfile, vaHIdx + 1) : 0.0
            if addL >= addH and vaLIdx > 0
                vaLIdx -= 1
                vaVol  += addL
            else if vaHIdx < frvpRows - 1
                vaHIdx += 1
                vaVol  += addH
            else
                break

        vaLow  := rangeLo + vaLIdx * rowHeight
        vaHigh := rangeLo + (vaHIdx + 1) * rowHeight

// --- Draw FRVP ---
var line  pocLine = na
var box   vaBox   = na
var label pocLbl  = na

line.delete(pocLine)
box.delete(vaBox)
label.delete(pocLbl)

if frvpEnabled and not na(pocLevel)
    pocLine := line.new(bar_index - frvpLen, pocLevel, bar_index, pocLevel, color=pocColor, width=frvpPocWidth, style=line.style_solid)
    pocLbl  := label.new(bar_index, pocLevel, "POC " + str.tostring(pocLevel, format.mintick), style=label.style_label_left, color=color.new(pocColor, 60), textcolor=pocColor, size=size.small)
    if frvpShowVA and not na(vaHigh) and not na(vaLow)
        vaBox := box.new(bar_index - frvpLen, vaHigh, bar_index, vaLow, border_color=color.new(vaColor, 40), bgcolor=vaColor, border_width=1)

// =============================================
// CONFLUENCE SCORING
// =============================================

priceInBullOB = false
priceInBearOB = false

if array.size(obTops) > 0
    for i = 0 to array.size(obTops) - 1
        t = array.get(obTops, i)
        b = array.get(obBottoms, i)
        isBull = array.get(obIsBull, i)
        if isBull and low <= t and low >= b
            priceInBullOB := true
        if not isBull and high >= b and high <= t
            priceInBearOB := true

priceAtPOC = frvpEnabled and not na(pocLevel) and not na(atrVal) and math.abs(close - pocLevel) < atrVal * 0.5
priceAtVAL = frvpEnabled and not na(vaLow) and not na(atrVal) and math.abs(low - vaLow) < atrVal * 0.3
priceAtVAH = frvpEnabled and not na(vaHigh) and not na(atrVal) and math.abs(high - vaHigh) < atrVal * 0.3

bullScore  = 0
bullScore += priceInBullOB ? 1 : 0
bullScore += ofBullish ? 1 : 0
bullScore += (priceAtPOC or priceAtVAL) ? 1 : 0
bullScore += msTrend == 1 ? 1 : 0

bearScore  = 0
bearScore += priceInBearOB ? 1 : 0
bearScore += ofBearish ? 1 : 0
bearScore += (priceAtPOC or priceAtVAH) ? 1 : 0
bearScore += msTrend == -1 ? 1 : 0

// =============================================
// ENTRY SIGNALS
// =============================================

bullEntry = bullScore >= modeConfReq and sessionOK and showEntries
bearEntry = bearScore >= modeConfReq and sessionOK and showEntries

var bool prevBull = false
var bool prevBear = false
filteredBull = bullEntry and not prevBull
filteredBear = bearEntry and not prevBear
prevBull := bullEntry
prevBear := bearEntry

plotshape(filteredBull, "Bull Entry", shape.triangleup, location.belowbar, entryBullCol, size=size.small)
plotshape(filteredBear, "Bear Entry", shape.triangledown, location.abovebar, entryBearCol, size=size.small)

// --- TP / SL Lines ---
if filteredBull and not na(atrVal)
    slVal = close - atrVal * modeSLMult
    tpVal = close + atrVal * modeSLMult * modeRR
    if showSL
        line.new(bar_index, close, bar_index + 10, slVal, color=color.red, style=line.style_dotted, width=1)
        label.new(bar_index + 10, slVal, "SL " + str.tostring(slVal, format.mintick), style=label.style_label_left, color=color.new(color.red, 70), textcolor=color.red, size=size.tiny)
    if showTP
        line.new(bar_index, close, bar_index + 10, tpVal, color=color.green, style=line.style_dotted, width=1)
        label.new(bar_index + 10, tpVal, "TP " + str.tostring(tpVal, format.mintick), style=label.style_label_left, color=color.new(color.green, 70), textcolor=color.green, size=size.tiny)

if filteredBear and not na(atrVal)
    slVal = close + atrVal * modeSLMult
    tpVal = close - atrVal * modeSLMult * modeRR
    if showSL
        line.new(bar_index, close, bar_index + 10, slVal, color=color.red, style=line.style_dotted, width=1)
        label.new(bar_index + 10, slVal, "SL " + str.tostring(slVal, format.mintick), style=label.style_label_left, color=color.new(color.red, 70), textcolor=color.red, size=size.tiny)
    if showTP
        line.new(bar_index, close, bar_index + 10, tpVal, color=color.green, style=line.style_dotted, width=1)
        label.new(bar_index + 10, tpVal, "TP " + str.tostring(tpVal, format.mintick), style=label.style_label_left, color=color.new(color.green, 70), textcolor=color.green, size=size.tiny)

// =============================================
// ORDER FLOW LABELS
// =============================================

if ofEnabled and deltaDivBull
    label.new(bar_index, low, "D+", style=label.style_label_up, color=color.new(entryBullCol, 70), textcolor=entryBullCol, size=size.tiny)

if ofEnabled and deltaDivBear
    label.new(bar_index, high, "D-", style=label.style_label_down, color=color.new(entryBearCol, 70), textcolor=entryBearCol, size=size.tiny)

if ofEnabled and absorption
    if close > open
        label.new(bar_index, low, "ABS", style=label.style_label_up, color=color.new(color.yellow, 60), textcolor=color.yellow, size=size.tiny)
    else
        label.new(bar_index, high, "ABS", style=label.style_label_down, color=color.new(color.yellow, 60), textcolor=color.yellow, size=size.tiny)

// =============================================
// INFO TABLE
// =============================================

var table infoTbl = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.new(color.gray, 60))

if barstate.islast
    table.cell(infoTbl, 0, 0, "Mode", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 0, tradeMode, text_color=color.white, text_size=size.small)

    table.cell(infoTbl, 0, 1, "Trend", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 1, msTrend == 1 ? "Bullish" : msTrend == -1 ? "Bearish" : "Neutral", text_color=msTrend == 1 ? entryBullCol : msTrend == -1 ? entryBearCol : color.gray, text_size=size.small)

    table.cell(infoTbl, 0, 2, "POC", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 2, not na(pocLevel) ? str.tostring(pocLevel, format.mintick) : "-", text_color=pocColor, text_size=size.small)

    table.cell(infoTbl, 0, 3, "VA High", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 3, not na(vaHigh) ? str.tostring(vaHigh, format.mintick) : "-", text_color=color.blue, text_size=size.small)

    table.cell(infoTbl, 0, 4, "VA Low", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 4, not na(vaLow) ? str.tostring(vaLow, format.mintick) : "-", text_color=color.blue, text_size=size.small)

    table.cell(infoTbl, 0, 5, "ATR", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 5, not na(atrVal) ? str.tostring(atrVal, format.mintick) : "-", text_color=color.white, text_size=size.small)

    table.cell(infoTbl, 0, 6, "Delta", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 6, str.tostring(delta, "#.##"), text_color=delta > 0 ? entryBullCol : entryBearCol, text_size=size.small)

    table.cell(infoTbl, 0, 7, "Bull Score", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 7, str.tostring(bullScore) + "/4", text_color=entryBullCol, text_size=size.small)

    table.cell(infoTbl, 0, 8, "Bear Score", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 8, str.tostring(bearScore) + "/4", text_color=entryBearCol, text_size=size.small)

    table.cell(infoTbl, 0, 9, "Active OBs", text_color=color.gray, text_size=size.small)
    table.cell(infoTbl, 1, 9, str.tostring(array.size(obTops)), text_color=color.white, text_size=size.small)

// =============================================
// ALERTS
// =============================================

alertcondition(filteredBull, "Bullish Entry", "XAUUSD Bullish Entry at {{close}}")
alertcondition(filteredBear, "Bearish Entry", "XAUUSD Bearish Entry at {{close}}")
alertcondition(filteredBull and bullScore >= 3, "High Conf Bull", "XAUUSD High Confidence Bull at {{close}}")
alertcondition(filteredBear and bearScore >= 3, "High Conf Bear", "XAUUSD High Confidence Bear at {{close}}")
