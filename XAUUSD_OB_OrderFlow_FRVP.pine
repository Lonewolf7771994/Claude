// This Pine Script is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// XAUUSD OB + Order Flow + FRVP - Clean Entry System
// OANDA:XAUUSD - All Timeframes

//@version=6
indicator("XAUUSD OB+OF+FRVP", shorttitle="OB-FRVP", overlay=true, max_boxes_count=100, max_lines_count=100, max_labels_count=200)

// =============================================
// INPUTS
// =============================================

tradeMode    = input.string("Swing", "Mode", options=["Swing", "Scalp", "Intraday", "Sniper"], group="Mode")
obLength     = input.int(5, "OB Lookback", minval=2, maxval=50, group="Order Blocks")
obMaxAge     = input.int(80, "Max OB Age (bars)", minval=10, maxval=300, group="Order Blocks")
obRefine     = input.bool(true, "Refine to Wick (Sniper)", group="Order Blocks")
ofEnabled    = input.bool(true, "Enable Order Flow", group="Order Flow")
ofDelta      = input.int(14, "Delta Period", minval=5, maxval=50, group="Order Flow")
ofAbsorb     = input.float(2.5, "Absorption Threshold", minval=1.0, maxval=5.0, step=0.1, group="Order Flow")
ofImbalance  = input.float(3.0, "Imbalance Ratio", minval=1.5, maxval=10.0, step=0.5, group="Order Flow")
frvpEnabled  = input.bool(true, "Enable FRVP", group="FRVP")
frvpLen      = input.int(50, "FRVP Lookback", minval=10, maxval=300, group="FRVP")
frvpRows     = input.int(40, "FRVP Rows", minval=10, maxval=100, group="FRVP")
frvpVAPct    = input.float(70.0, "Value Area %", minval=50.0, maxval=90.0, step=5.0, group="FRVP")
structLen    = input.int(5, "Pivot Length", minval=2, maxval=20, group="Structure")
showBOS      = input.bool(true, "Show BOS", group="Structure")
showCHoCH    = input.bool(true, "Show CHoCH", group="Structure")
riskReward   = input.float(3.0, "Risk:Reward", minval=1.0, maxval=10.0, step=0.5, group="Entries")
atrMult      = input.float(1.5, "ATR SL Multiplier", minval=0.5, maxval=5.0, step=0.1, group="Entries")
cooldownBars = input.int(10, "Min Bars Between Signals", minval=3, maxval=50, group="Entries")
sessFilter   = input.bool(false, "Session Filter", group="Sessions")
sessLondon   = input.bool(true, "London", group="Sessions")
sessNY       = input.bool(true, "New York", group="Sessions")
sessAsia     = input.bool(false, "Asia", group="Sessions")

// =============================================
// COLORS
// =============================================

color C_BULL      = #089981
color C_BEAR      = #F23645
color C_BULL_BG   = color.new(#089981, 85)
color C_BEAR_BG   = color.new(#F23645, 85)
color C_POC       = color.new(#FF9800, 20)
color C_VA        = color.new(#2196F3, 90)
color C_NEUTRAL   = color.new(color.gray, 50)

// =============================================
// MODE PARAMETERS
// =============================================

modeATRLen  = tradeMode == "Swing" ? 20 : tradeMode == "Scalp" ? 7 : tradeMode == "Intraday" ? 14 : 10
modeSLMult  = tradeMode == "Swing" ? atrMult * 1.5 : tradeMode == "Scalp" ? atrMult * 0.6 : tradeMode == "Intraday" ? atrMult : atrMult * 0.4
modeRR      = tradeMode == "Swing" ? riskReward : tradeMode == "Scalp" ? math.max(riskReward * 0.5, 1.5) : tradeMode == "Intraday" ? riskReward * 0.75 : riskReward * 1.5
modeOBLen   = tradeMode == "Swing" ? obLength * 2 : tradeMode == "Intraday" ? int(math.round(obLength * 1.5)) : obLength
modeConfReq = tradeMode == "Sniper" ? 3 : tradeMode == "Scalp" ? 2 : 2

// =============================================
// SESSION
// =============================================

hourET    = hour + minute / 60.0
sessionOK = not sessFilter or (sessLondon and hourET >= 3.0 and hourET < 12.0) or (sessNY and hourET >= 8.0 and hourET < 17.0) or (sessAsia and (hourET >= 19.0 or hourET < 4.0))

// =============================================
// ATR
// =============================================

atrVal = ta.atr(modeATRLen)

// =============================================
// MARKET STRUCTURE
// =============================================

pivHi = ta.pivothigh(high, structLen, structLen)
pivLo = ta.pivotlow(low, structLen, structLen)

var float lastHH  = na
var float lastLL  = na
var int   msTrend = 0

if not na(pivHi)
    if pivHi > nz(lastHH, pivHi)
        if msTrend == -1 and showCHoCH
            label.new(bar_index - structLen, pivHi, "CHoCH", style=label.style_label_down, color=color.new(C_BULL, 30), textcolor=color.white, size=size.tiny)
        lastHH  := pivHi
        msTrend := 1

if not na(pivLo)
    if pivLo < nz(lastLL, pivLo)
        if msTrend == 1 and showCHoCH
            label.new(bar_index - structLen, pivLo, "CHoCH", style=label.style_label_up, color=color.new(C_BEAR, 30), textcolor=color.white, size=size.tiny)
        lastLL  := pivLo
        msTrend := -1

if not na(pivHi) and pivHi > nz(lastHH, pivHi) and msTrend == 1 and showBOS
    label.new(bar_index - structLen, pivHi, "BOS", style=label.style_label_down, color=color.new(C_BULL, 60), textcolor=C_BULL, size=size.tiny)

if not na(pivLo) and pivLo < nz(lastLL, pivLo) and msTrend == -1 and showBOS
    label.new(bar_index - structLen, pivLo, "BOS", style=label.style_label_up, color=color.new(C_BEAR, 60), textcolor=C_BEAR, size=size.tiny)

// =============================================
// ORDER BLOCKS (max 6 active, clean boxes)
// =============================================

var array<float> obTops    = array.new_float(0)
var array<float> obBottoms = array.new_float(0)
var array<int>   obBars    = array.new_int(0)
var array<bool>  obIsBull  = array.new_bool(0)
var array<box>   obBoxes   = array.new_box(0)

avgBody = ta.sma(math.abs(close - open), 20)

bullOBFound = false
bearOBFound = false
bullTop = 0.0
bullBot = 0.0
bearTop = 0.0
bearBot = 0.0

for i = 1 to modeOBLen
    if not bullOBFound
        bodySize = math.abs(close[i] - open[i])
        if close[i] > open[i] and close[i + 1] < open[i + 1] and close[i] > high[i + 1] and bodySize > avgBody * 2.0
            bullOBFound := true
            if obRefine and tradeMode == "Sniper"
                bullBot := low[i + 1]
                bullTop := math.min(open[i + 1], close[i + 1])
            else
                bullBot := low[i + 1]
                bullTop := high[i + 1]

for i = 1 to modeOBLen
    if not bearOBFound
        bodySize = math.abs(close[i] - open[i])
        if close[i] < open[i] and close[i + 1] > open[i + 1] and close[i] < low[i + 1] and bodySize > avgBody * 2.0
            bearOBFound := true
            if obRefine and tradeMode == "Sniper"
                bearTop := high[i + 1]
                bearBot := math.max(open[i + 1], close[i + 1])
            else
                bearTop := high[i + 1]
                bearBot := low[i + 1]

maxOBs = 6

if bullOBFound and array.size(obTops) < maxOBs
    bx = box.new(bar_index - modeOBLen, bullTop, bar_index + 20, bullBot, border_color=color.new(C_BULL, 40), bgcolor=C_BULL_BG, border_width=1, border_style=line.style_dashed)
    array.push(obTops, bullTop)
    array.push(obBottoms, bullBot)
    array.push(obBars, bar_index)
    array.push(obIsBull, true)
    array.push(obBoxes, bx)

if bearOBFound and array.size(obTops) < maxOBs
    bx = box.new(bar_index - modeOBLen, bearTop, bar_index + 20, bearBot, border_color=color.new(C_BEAR, 40), bgcolor=C_BEAR_BG, border_width=1, border_style=line.style_dashed)
    array.push(obTops, bearTop)
    array.push(obBottoms, bearBot)
    array.push(obBars, bar_index)
    array.push(obIsBull, false)
    array.push(obBoxes, bx)

if array.size(obTops) > 0
    for i = array.size(obTops) - 1 to 0
        t = array.get(obTops, i)
        b = array.get(obBottoms, i)
        bull = array.get(obIsBull, i)
        age = bar_index - array.get(obBars, i)
        mitigated = age > obMaxAge or (bull and close < b) or (not bull and close > t)
        if mitigated
            box.delete(array.get(obBoxes, i))
            array.remove(obTops, i)
            array.remove(obBottoms, i)
            array.remove(obBars, i)
            array.remove(obIsBull, i)
            array.remove(obBoxes, i)
        else
            box.set_right(array.get(obBoxes, i), bar_index + 3)

// =============================================
// ORDER FLOW (no labels - only scoring)
// =============================================

spread   = high - low
safeDiv  = math.max(spread, syminfo.mintick)
bullVol  = close >= open ? volume : volume * math.max(close - low, 0.0) / safeDiv
bearVol  = close <= open ? volume : volume * math.max(high - close, 0.0) / safeDiv
delta    = bullVol - bearVol
deltaMA  = ta.sma(delta, ofDelta)
avgVol   = ta.sma(volume, ofDelta)

deltaDivBull = close < close[1] and delta > deltaMA and delta > 0
deltaDivBear = close > close[1] and delta < -deltaMA and delta < 0
absorption   = not na(atrVal) and volume > avgVol * ofAbsorb and math.abs(close - open) < atrVal * 0.3
stackedBull  = bullVol > bearVol * ofImbalance and bullVol[1] > bearVol[1] * ofImbalance
stackedBear  = bearVol > bullVol * ofImbalance and bearVol[1] > bullVol[1] * ofImbalance

ofBullish = ofEnabled and (deltaDivBull or (absorption and close > open) or stackedBull)
ofBearish = ofEnabled and (deltaDivBear or (absorption and close < open) or stackedBear)

// =============================================
// FRVP
// =============================================

var float pocLevel = na
var float vaHigh   = na
var float vaLow    = na
var array<float> volProfile = array.new_float(0)

if frvpEnabled and bar_index > frvpLen
    rangeHi   = ta.highest(high, frvpLen)
    rangeLo   = ta.lowest(low, frvpLen)
    rangeSize = rangeHi - rangeLo

    if rangeSize > syminfo.mintick
        rowHeight = rangeSize / frvpRows
        array.clear(volProfile)
        for r = 0 to frvpRows - 1
            array.push(volProfile, 0.0)

        for j = 0 to frvpLen - 1
            bSpread = math.max(high[j] - low[j], syminfo.mintick)
            rowsHit = math.max(1, int(math.round(bSpread / rowHeight)))
            bVol    = volume[j] / rowsHit
            sRow    = int(math.max(0.0, math.floor((low[j] - rangeLo) / rowHeight)))
            eRow    = int(math.min(frvpRows - 1.0, math.floor((high[j] - rangeLo) / rowHeight)))
            if sRow >= 0 and eRow < frvpRows and sRow <= eRow
                for r = sRow to eRow
                    array.set(volProfile, r, array.get(volProfile, r) + bVol)

        maxVol = 0.0
        pocIdx = 0
        for r = 0 to frvpRows - 1
            v = array.get(volProfile, r)
            if v > maxVol
                maxVol := v
                pocIdx := r

        pocLevel := rangeLo + (pocIdx + 0.5) * rowHeight

        totalVol = 0.0
        for r = 0 to frvpRows - 1
            totalVol += array.get(volProfile, r)

        vaTarget = totalVol * frvpVAPct / 100.0
        vaVol    = array.get(volProfile, pocIdx)
        vaLIdx   = pocIdx
        vaHIdx   = pocIdx
        cnt = 0
        while vaVol < vaTarget and (vaLIdx > 0 or vaHIdx < frvpRows - 1) and cnt < frvpRows
            cnt += 1
            addL = vaLIdx > 0 ? array.get(volProfile, vaLIdx - 1) : 0.0
            addH = vaHIdx < frvpRows - 1 ? array.get(volProfile, vaHIdx + 1) : 0.0
            if addL >= addH and vaLIdx > 0
                vaLIdx -= 1
                vaVol  += addL
            else if vaHIdx < frvpRows - 1
                vaHIdx += 1
                vaVol  += addH
            else
                break
        vaLow  := rangeLo + vaLIdx * rowHeight
        vaHigh := rangeLo + (vaHIdx + 1) * rowHeight

// --- Draw FRVP: just POC line + subtle VA ---
var line  pocLine = na
var box   vaBox   = na
var label pocLbl  = na

line.delete(pocLine)
box.delete(vaBox)
label.delete(pocLbl)

if frvpEnabled and not na(pocLevel)
    pocLine := line.new(bar_index - frvpLen, pocLevel, bar_index, pocLevel, color=C_POC, width=2, style=line.style_solid)
    pocLbl  := label.new(bar_index + 2, pocLevel, "POC", style=label.style_label_left, color=color.new(C_POC, 80), textcolor=C_POC, size=size.tiny)
    if not na(vaHigh) and not na(vaLow)
        vaBox := box.new(bar_index - frvpLen, vaHigh, bar_index, vaLow, border_color=color.new(C_VA, 70), bgcolor=C_VA, border_width=0)

// =============================================
// CONFLUENCE SCORING
// =============================================

priceInBullOB = false
priceInBearOB = false
if array.size(obTops) > 0
    for i = 0 to array.size(obTops) - 1
        t = array.get(obTops, i)
        b = array.get(obBottoms, i)
        bull = array.get(obIsBull, i)
        if bull and low <= t and low >= b
            priceInBullOB := true
        if not bull and high >= b and high <= t
            priceInBearOB := true

priceAtPOC = frvpEnabled and not na(pocLevel) and not na(atrVal) and math.abs(close - pocLevel) < atrVal * 0.4
priceAtVAL = frvpEnabled and not na(vaLow) and not na(atrVal) and math.abs(low - vaLow) < atrVal * 0.3
priceAtVAH = frvpEnabled and not na(vaHigh) and not na(atrVal) and math.abs(high - vaHigh) < atrVal * 0.3

bullScore  = 0
bullScore += priceInBullOB ? 1 : 0
bullScore += ofBullish ? 1 : 0
bullScore += (priceAtPOC or priceAtVAL) ? 1 : 0
bullScore += msTrend == 1 ? 1 : 0

bearScore  = 0
bearScore += priceInBearOB ? 1 : 0
bearScore += ofBearish ? 1 : 0
bearScore += (priceAtPOC or priceAtVAH) ? 1 : 0
bearScore += msTrend == -1 ? 1 : 0

// =============================================
// ENTRIES (with cooldown + clean visuals)
// =============================================

bullEntry = bullScore >= modeConfReq and sessionOK
bearEntry = bearScore >= modeConfReq and sessionOK

var int lastBullBar = -999
var int lastBearBar = -999

filteredBull = bullEntry and (bar_index - lastBullBar) > cooldownBars
filteredBear = bearEntry and (bar_index - lastBearBar) > cooldownBars

if filteredBull
    lastBullBar := bar_index
if filteredBear
    lastBearBar := bar_index

// --- Clean entry markers ---
plotshape(filteredBull, "LONG", shape.labelup, location.belowbar, C_BULL, size=size.normal, text="LONG", textcolor=color.white)
plotshape(filteredBear, "SHORT", shape.labeldown, location.abovebar, C_BEAR, size=size.normal, text="SHORT", textcolor=color.white)

// --- SL/TP: single clean line per entry ---
if filteredBull and not na(atrVal)
    sl = close - atrVal * modeSLMult
    tp = close + atrVal * modeSLMult * modeRR
    line.new(bar_index, sl, bar_index + 15, sl, color=color.new(C_BEAR, 40), width=1, style=line.style_dotted)
    line.new(bar_index, tp, bar_index + 15, tp, color=color.new(C_BULL, 40), width=1, style=line.style_dotted)
    label.new(bar_index + 15, sl, str.tostring(sl, format.mintick), style=label.style_none, textcolor=C_BEAR, size=size.tiny)
    label.new(bar_index + 15, tp, str.tostring(tp, format.mintick), style=label.style_none, textcolor=C_BULL, size=size.tiny)

if filteredBear and not na(atrVal)
    sl = close + atrVal * modeSLMult
    tp = close - atrVal * modeSLMult * modeRR
    line.new(bar_index, sl, bar_index + 15, sl, color=color.new(C_BEAR, 40), width=1, style=line.style_dotted)
    line.new(bar_index, tp, bar_index + 15, tp, color=color.new(C_BULL, 40), width=1, style=line.style_dotted)
    label.new(bar_index + 15, sl, str.tostring(sl, format.mintick), style=label.style_none, textcolor=C_BEAR, size=size.tiny)
    label.new(bar_index + 15, tp, str.tostring(tp, format.mintick), style=label.style_none, textcolor=C_BULL, size=size.tiny)

// =============================================
// CONFLUENCE BAR COLOR (subtle highlight)
// =============================================

barcolor(filteredBull ? C_BULL : filteredBear ? C_BEAR : na)

// =============================================
// INFO TABLE (compact)
// =============================================

var table tbl = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 85), border_width=0)

if barstate.islast
    table.cell(tbl, 0, 0, tradeMode, text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(tbl, 1, 0, msTrend == 1 ? "BULL" : msTrend == -1 ? "BEAR" : "FLAT", text_color=msTrend == 1 ? C_BULL : msTrend == -1 ? C_BEAR : color.gray, text_size=size.small)
    table.cell(tbl, 0, 1, "POC", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 1, not na(pocLevel) ? str.tostring(pocLevel, format.mintick) : "-", text_color=color.new(color.orange, 0), text_size=size.tiny)
    table.cell(tbl, 0, 2, "VA", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 2, not na(vaLow) and not na(vaHigh) ? str.tostring(vaLow, format.mintick) + " - " + str.tostring(vaHigh, format.mintick) : "-", text_color=color.new(color.blue, 20), text_size=size.tiny)
    table.cell(tbl, 0, 3, "ATR", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 3, not na(atrVal) ? str.tostring(atrVal, format.mintick) : "-", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 4, "OBs", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 4, str.tostring(array.size(obTops)), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 5, "Bull", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 5, str.tostring(bullScore) + "/4", text_color=C_BULL, text_size=size.tiny)
    table.cell(tbl, 0, 6, "Bear", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 6, str.tostring(bearScore) + "/4", text_color=C_BEAR, text_size=size.tiny)

// =============================================
// ALERTS
// =============================================

alertcondition(filteredBull, "Long Entry", "XAUUSD LONG at {{close}}")
alertcondition(filteredBear, "Short Entry", "XAUUSD SHORT at {{close}}")
alertcondition(filteredBull and bullScore >= 3, "High Conf Long", "XAUUSD HIGH CONF LONG at {{close}}")
alertcondition(filteredBear and bearScore >= 3, "High Conf Short", "XAUUSD HIGH CONF SHORT at {{close}}")
