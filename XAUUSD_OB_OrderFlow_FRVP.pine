// This Pine Script is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// XAUUSD Smart Money Entry Engine
// OB at Structure + Pullback Entry + Order Flow + FRVP
// OANDA:XAUUSD - All Timeframes

//@version=6
indicator("XAUUSD SMC Engine", shorttitle="SMC-Engine", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =============================================
// INPUTS
// =============================================

tradeMode    = input.string("Swing", "Mode", options=["Swing", "Scalp", "Intraday", "Sniper"], group="Mode")
structLen    = input.int(5, "Structure Pivot Length", minval=2, maxval=20, group="Structure")
obScanLen    = input.int(10, "OB Origin Scan (bars)", minval=3, maxval=30, group="Order Blocks")
obMaxAge     = input.int(100, "Max OB Age (bars)", minval=20, maxval=500, group="Order Blocks")
showBOS      = input.bool(true, "Show BOS", group="Structure")
showCHoCH    = input.bool(true, "Show CHoCH", group="Structure")
ofEnabled    = input.bool(true, "Enable Order Flow", group="Order Flow")
ofDelta      = input.int(14, "Delta Period", minval=5, maxval=50, group="Order Flow")
ofImbalance  = input.float(2.5, "Imbalance Ratio", minval=1.5, maxval=10.0, step=0.5, group="Order Flow")
frvpEnabled  = input.bool(true, "Enable FRVP", group="FRVP")
frvpLen      = input.int(50, "FRVP Lookback", minval=10, maxval=300, group="FRVP")
frvpRows     = input.int(40, "FRVP Rows", minval=10, maxval=100, group="FRVP")
frvpVAPct    = input.float(70.0, "Value Area %", minval=50.0, maxval=90.0, step=5.0, group="FRVP")
cooldownBars = input.int(8, "Min Bars Between Signals", minval=2, maxval=50, group="Entries")
tpslWidth    = input.int(15, "TP/SL Box Width (bars)", minval=5, maxval=40, group="Entries")
riskReward   = input.float(3.0, "Fallback R:R", minval=1.0, maxval=10.0, step=0.5, group="Entries")
slBuffer     = input.float(0.2, "SL Buffer (x ATR)", minval=0.05, maxval=1.0, step=0.05, group="Entries")
sessFilter   = input.bool(false, "Session Filter", group="Sessions")
sessLondon   = input.bool(true, "London", group="Sessions")
sessNY       = input.bool(true, "New York", group="Sessions")
sessAsia     = input.bool(false, "Asia", group="Sessions")

// =============================================
// COLORS
// =============================================

color C_BULL    = #089981
color C_BEAR    = #F23645
color C_DEMANDBG = color.new(#089981, 82)
color C_SUPPLYBG = color.new(#F23645, 82)
color C_TP      = color.new(#089981, 75)
color C_SL      = color.new(#F23645, 75)
color C_ENTRY   = color.new(#2962FF, 20)
color C_POC     = color.new(#FF9800, 15)
color C_VA      = color.new(#2196F3, 92)

// =============================================
// MODE-ADAPTIVE
// =============================================

modeStructLen = tradeMode == "Swing" ? structLen * 2 : tradeMode == "Scalp" ? math.max(2, int(math.round(structLen * 0.6))) : structLen
modeOBScan    = tradeMode == "Swing" ? obScanLen * 2 : tradeMode == "Scalp" ? obScanLen : obScanLen
modeRefine    = tradeMode == "Sniper" or tradeMode == "Scalp"
modeSLBuf     = tradeMode == "Swing" ? slBuffer * 1.5 : tradeMode == "Scalp" ? slBuffer * 0.5 : tradeMode == "Sniper" ? slBuffer * 0.3 : slBuffer
modeConfReq   = tradeMode == "Sniper" ? 2 : 0
modeATRLen    = tradeMode == "Swing" ? 20 : tradeMode == "Scalp" ? 7 : 14
modeMaxTPAtr  = tradeMode == "Swing" ? 12.0 : tradeMode == "Intraday" ? 6.0 : tradeMode == "Scalp" ? 2.5 : 4.0
modeMaxOBAtr  = tradeMode == "Swing" ? 3.0 : tradeMode == "Scalp" ? 1.2 : tradeMode == "Sniper" ? 1.5 : 2.0
modePBBars    = tradeMode == "Swing" ? 6 : tradeMode == "Scalp" ? 2 : tradeMode == "Sniper" ? 3 : 4

// =============================================
// SESSION
// =============================================

hourET    = hour + minute / 60.0
sessionOK = not sessFilter or (sessLondon and hourET >= 3.0 and hourET < 12.0) or (sessNY and hourET >= 8.0 and hourET < 17.0) or (sessAsia and (hourET >= 19.0 or hourET < 4.0))

// =============================================
// ATR
// =============================================

atrVal = ta.atr(modeATRLen)

// =============================================
// STRUCTURE: PIVOTS + BOS/CHoCH
// =============================================

pivHi = ta.pivothigh(high, modeStructLen, modeStructLen)
pivLo = ta.pivotlow(low, modeStructLen, modeStructLen)

var float swingHi      = na
var float swingLo      = na
var int   trend        = 0
var bool  bosUpHandled = false
var bool  bosDnHandled = false
var int   lastBOSBar   = 0

if not na(pivHi)
    swingHi      := pivHi
    bosUpHandled := false

if not na(pivLo)
    swingLo      := pivLo
    bosDnHandled := false

bosUp = not na(swingHi) and close > swingHi and not bosUpHandled
bosDn = not na(swingLo) and close < swingLo and not bosDnHandled

// =============================================
// ORDER BLOCKS: Created at BOS origin
// =============================================

var array<float> obTops    = array.new_float(0)
var array<float> obBottoms = array.new_float(0)
var array<int>   obStartB  = array.new_int(0)
var array<bool>  obIsBull  = array.new_bool(0)
var array<float> obTargets = array.new_float(0)
var array<box>   obBoxes   = array.new_box(0)

maxOBs = 10

if bosUp
    bosUpHandled := true
    lastBOSBar   := bar_index
    isCHoCH      = trend == -1
    if isCHoCH and showCHoCH
        label.new(bar_index, high, "CHoCH", style=label.style_label_down, color=color.new(C_BULL, 20), textcolor=color.white, size=size.tiny)
    else if showBOS
        label.new(bar_index, high, "BOS", style=label.style_label_down, color=color.new(C_BULL, 50), textcolor=C_BULL, size=size.tiny)
    trend := 1
    for i = 1 to modeOBScan
        if close[i] < open[i]
            obT = modeRefine ? math.max(open[i], close[i]) : high[i]
            obB = low[i]
            obSize = obT - obB
            if obSize > 0 and (na(atrVal) or obSize <= atrVal * modeMaxOBAtr) and array.size(obTops) < maxOBs
                bx = box.new(bar_index - i, obT, bar_index + 20, obB, border_color=color.new(C_BULL, 30), bgcolor=C_DEMANDBG, border_width=2)
                array.push(obTops, obT)
                array.push(obBottoms, obB)
                array.push(obStartB, bar_index)
                array.push(obIsBull, true)
                array.push(obTargets, swingHi)
                array.push(obBoxes, bx)
            break

if bosDn
    bosDnHandled := true
    lastBOSBar   := bar_index
    isCHoCH      = trend == 1
    if isCHoCH and showCHoCH
        label.new(bar_index, low, "CHoCH", style=label.style_label_up, color=color.new(C_BEAR, 20), textcolor=color.white, size=size.tiny)
    else if showBOS
        label.new(bar_index, low, "BOS", style=label.style_label_up, color=color.new(C_BEAR, 50), textcolor=C_BEAR, size=size.tiny)
    trend := -1
    for i = 1 to modeOBScan
        if close[i] > open[i]
            obT = high[i]
            obB = modeRefine ? math.min(open[i], close[i]) : low[i]
            obSize = obT - obB
            if obSize > 0 and (na(atrVal) or obSize <= atrVal * modeMaxOBAtr) and array.size(obTops) < maxOBs
                bx = box.new(bar_index - i, obT, bar_index + 20, obB, border_color=color.new(C_BEAR, 30), bgcolor=C_SUPPLYBG, border_width=2)
                array.push(obTops, obT)
                array.push(obBottoms, obB)
                array.push(obStartB, bar_index)
                array.push(obIsBull, false)
                array.push(obTargets, swingLo)
                array.push(obBoxes, bx)
            break

// --- Manage OBs: extend or mitigate ---
if array.size(obTops) > 0
    for i = array.size(obTops) - 1 to 0
        t    = array.get(obTops, i)
        b    = array.get(obBottoms, i)
        bull = array.get(obIsBull, i)
        age  = bar_index - array.get(obStartB, i)
        mitigated = age > obMaxAge
        if bull and close < b
            mitigated := true
        if not bull and close > t
            mitigated := true
        if mitigated
            box.delete(array.get(obBoxes, i))
            array.remove(obTops, i)
            array.remove(obBottoms, i)
            array.remove(obStartB, i)
            array.remove(obIsBull, i)
            array.remove(obTargets, i)
            array.remove(obBoxes, i)
        else
            box.set_right(array.get(obBoxes, i), bar_index + 3)

// =============================================
// ORDER FLOW
// =============================================

spread   = high - low
safeDiv  = math.max(spread, syminfo.mintick)
bullVol  = close >= open ? volume : volume * math.max(close - low, 0.0) / safeDiv
bearVol  = close <= open ? volume : volume * math.max(high - close, 0.0) / safeDiv
delta    = bullVol - bearVol
deltaMA  = ta.sma(delta, ofDelta)
avgVol   = ta.sma(volume, ofDelta)

ofBullish = ofEnabled and ((delta > 0 and delta > deltaMA) or (bullVol > bearVol * ofImbalance))
ofBearish = ofEnabled and ((delta < 0 and delta < -deltaMA) or (bearVol > bullVol * ofImbalance))

// =============================================
// FRVP
// =============================================

var float pocLevel = na
var float vaHigh   = na
var float vaLow    = na
var array<float> volProfile = array.new_float(0)

if frvpEnabled and bar_index > frvpLen
    rangeHi   = ta.highest(high, frvpLen)
    rangeLo   = ta.lowest(low, frvpLen)
    rangeSize = rangeHi - rangeLo
    if rangeSize > syminfo.mintick
        rowHeight = rangeSize / frvpRows
        array.clear(volProfile)
        for r = 0 to frvpRows - 1
            array.push(volProfile, 0.0)
        for j = 0 to frvpLen - 1
            bSpread = math.max(high[j] - low[j], syminfo.mintick)
            rowsHit = math.max(1, int(math.round(bSpread / rowHeight)))
            bVol    = volume[j] / rowsHit
            sRow    = int(math.max(0.0, math.floor((low[j] - rangeLo) / rowHeight)))
            eRow    = int(math.min(frvpRows - 1.0, math.floor((high[j] - rangeLo) / rowHeight)))
            if sRow >= 0 and eRow < frvpRows and sRow <= eRow
                for r = sRow to eRow
                    array.set(volProfile, r, array.get(volProfile, r) + bVol)
        maxVol = 0.0
        pocIdx = 0
        for r = 0 to frvpRows - 1
            v = array.get(volProfile, r)
            if v > maxVol
                maxVol := v
                pocIdx := r
        pocLevel := rangeLo + (pocIdx + 0.5) * rowHeight
        totalVol = 0.0
        for r = 0 to frvpRows - 1
            totalVol += array.get(volProfile, r)
        vaTarget = totalVol * frvpVAPct / 100.0
        vaVol    = array.get(volProfile, pocIdx)
        vaLIdx   = pocIdx
        vaHIdx   = pocIdx
        cnt = 0
        while vaVol < vaTarget and (vaLIdx > 0 or vaHIdx < frvpRows - 1) and cnt < frvpRows
            cnt += 1
            addL = vaLIdx > 0 ? array.get(volProfile, vaLIdx - 1) : 0.0
            addH = vaHIdx < frvpRows - 1 ? array.get(volProfile, vaHIdx + 1) : 0.0
            if addL >= addH and vaLIdx > 0
                vaLIdx -= 1
                vaVol  += addL
            else if vaHIdx < frvpRows - 1
                vaHIdx += 1
                vaVol  += addH
            else
                break
        vaLow  := rangeLo + vaLIdx * rowHeight
        vaHigh := rangeLo + (vaHIdx + 1) * rowHeight

var line  pocLine = na
var box   vaBox   = na
var label pocLbl  = na
line.delete(pocLine)
box.delete(vaBox)
label.delete(pocLbl)
if frvpEnabled and not na(pocLevel)
    pocLine := line.new(bar_index - frvpLen, pocLevel, bar_index, pocLevel, color=C_POC, width=2, style=line.style_solid)
    pocLbl  := label.new(bar_index + 2, pocLevel, "POC", style=label.style_label_left, color=color.new(C_POC, 70), textcolor=C_POC, size=size.tiny)
    if not na(vaHigh) and not na(vaLow)
        vaBox := box.new(bar_index - frvpLen, vaHigh, bar_index, vaLow, border_color=color.new(C_VA, 60), bgcolor=C_VA, border_width=0)

// =============================================
// ENTRY: Pullback into OB + Trend + Confirmation
// =============================================

priceInBullOB = false
priceInBearOB = false
entrySLLevel  = 0.0
entryTPLevel  = 0.0

if array.size(obTops) > 0
    for i = 0 to array.size(obTops) - 1
        t    = array.get(obTops, i)
        b    = array.get(obBottoms, i)
        bull = array.get(obIsBull, i)
        tgt  = array.get(obTargets, i)
        if bull and trend == 1 and low <= t and close >= b
            priceInBullOB := true
            entrySLLevel  := b
            entryTPLevel  := tgt
        if not bull and trend == -1 and high >= b and close <= t
            priceInBearOB := true
            entrySLLevel  := t
            entryTPLevel  := tgt

// Confluence (adds confidence, required in Sniper)
confBull = 0
confBull += ofBullish ? 1 : 0
confBull += (frvpEnabled and not na(pocLevel) and not na(atrVal) and math.abs(close - pocLevel) < atrVal * 0.6) ? 1 : 0
confBull += (frvpEnabled and not na(vaLow) and not na(atrVal) and math.abs(low - vaLow) < atrVal * 0.5) ? 1 : 0

confBear = 0
confBear += ofBearish ? 1 : 0
confBear += (frvpEnabled and not na(pocLevel) and not na(atrVal) and math.abs(close - pocLevel) < atrVal * 0.6) ? 1 : 0
confBear += (frvpEnabled and not na(vaHigh) and not na(atrVal) and math.abs(high - vaHigh) < atrVal * 0.5) ? 1 : 0

barsFromBOS = bar_index - lastBOSBar
pullbackReady = barsFromBOS >= modePBBars

bullSignal = priceInBullOB and confBull >= modeConfReq and sessionOK and pullbackReady and trend == 1
bearSignal = priceInBearOB and confBear >= modeConfReq and sessionOK and pullbackReady and trend == -1

// Cooldown
var int lastBullBar = -999
var int lastBearBar = -999
filteredBull = bullSignal and (bar_index - lastBullBar) > cooldownBars
filteredBear = bearSignal and (bar_index - lastBearBar) > cooldownBars
if filteredBull
    lastBullBar := bar_index
if filteredBear
    lastBearBar := bar_index

// =============================================
// ENTRY LABELS
// =============================================

plotshape(filteredBull, "LONG", shape.labelup, location.belowbar, C_BULL, size=size.normal, text="LONG", textcolor=color.white)
plotshape(filteredBear, "SHORT", shape.labeldown, location.abovebar, C_BEAR, size=size.normal, text="SHORT", textcolor=color.white)

// =============================================
// TP/SL BOXES (engine style)
// =============================================

if filteredBull and not na(atrVal) and entrySLLevel > 0
    ep = close
    sl = entrySLLevel - atrVal * modeSLBuf
    tp = entryTPLevel
    maxTP = atrVal * modeMaxTPAtr
    if tp <= ep
        risk = ep - sl
        tp := ep + risk * riskReward
    if tp - ep > maxTP
        tp := ep + maxTP
    if ep - sl < syminfo.mintick * 2
        sl := ep - atrVal * 0.5
    bL = bar_index
    bR = bar_index + tpslWidth
    box.new(bL, tp, bR, ep, border_color=C_BULL, bgcolor=C_TP, border_width=1)
    box.new(bL, ep, bR, sl, border_color=C_BEAR, bgcolor=C_SL, border_width=1)
    line.new(bL, ep, bR, ep, color=C_ENTRY, width=2, style=line.style_solid)
    rratio = (tp - ep) / math.max(ep - sl, syminfo.mintick)
    label.new(bR + 1, tp, "TP " + str.tostring(tp, format.mintick), style=label.style_none, textcolor=C_BULL, size=size.tiny)
    label.new(bR + 1, sl, "SL " + str.tostring(sl, format.mintick), style=label.style_none, textcolor=C_BEAR, size=size.tiny)
    label.new(bR + 1, ep, str.tostring(rratio, "#.#") + "R", style=label.style_none, textcolor=color.white, size=size.tiny)

if filteredBear and not na(atrVal) and entrySLLevel > 0
    ep = close
    sl = entrySLLevel + atrVal * modeSLBuf
    tp = entryTPLevel
    maxTP = atrVal * modeMaxTPAtr
    if tp >= ep
        risk = sl - ep
        tp := ep - risk * riskReward
    if ep - tp > maxTP
        tp := ep - maxTP
    if sl - ep < syminfo.mintick * 2
        sl := ep + atrVal * 0.5
    bL = bar_index
    bR = bar_index + tpslWidth
    box.new(bL, sl, bR, ep, border_color=C_BEAR, bgcolor=C_SL, border_width=1)
    box.new(bL, ep, bR, tp, border_color=C_BULL, bgcolor=C_TP, border_width=1)
    line.new(bL, ep, bR, ep, color=C_ENTRY, width=2, style=line.style_solid)
    rratio = (ep - tp) / math.max(sl - ep, syminfo.mintick)
    label.new(bR + 1, tp, "TP " + str.tostring(tp, format.mintick), style=label.style_none, textcolor=C_BULL, size=size.tiny)
    label.new(bR + 1, sl, "SL " + str.tostring(sl, format.mintick), style=label.style_none, textcolor=C_BEAR, size=size.tiny)
    label.new(bR + 1, ep, str.tostring(rratio, "#.#") + "R", style=label.style_none, textcolor=color.white, size=size.tiny)

// =============================================
// BAR COLOR
// =============================================

barcolor(filteredBull ? C_BULL : filteredBear ? C_BEAR : na)

// =============================================
// INFO TABLE
// =============================================

var table tbl = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 85), border_width=0)

if barstate.islast
    table.cell(tbl, 0, 0, tradeMode, text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(tbl, 1, 0, trend == 1 ? "BULL" : trend == -1 ? "BEAR" : "FLAT", text_color=trend == 1 ? C_BULL : trend == -1 ? C_BEAR : color.gray, text_size=size.small)
    table.cell(tbl, 0, 1, "POC", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 1, not na(pocLevel) ? str.tostring(pocLevel, format.mintick) : "-", text_color=color.new(color.orange, 0), text_size=size.tiny)
    table.cell(tbl, 0, 2, "VA", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 2, not na(vaLow) and not na(vaHigh) ? str.tostring(vaLow, format.mintick) + "-" + str.tostring(vaHigh, format.mintick) : "-", text_color=color.new(color.blue, 20), text_size=size.tiny)
    table.cell(tbl, 0, 3, "ATR", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 3, not na(atrVal) ? str.tostring(atrVal, format.mintick) : "-", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 4, "OBs", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 4, str.tostring(array.size(obTops)), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 5, "Delta", text_color=color.gray, text_size=size.tiny, text_halign=text.align_right)
    table.cell(tbl, 1, 5, str.tostring(delta, "#.#"), text_color=delta > 0 ? C_BULL : C_BEAR, text_size=size.tiny)

// =============================================
// ALERTS
// =============================================

alertcondition(filteredBull, "Long Entry", "XAUUSD LONG at {{close}}")
alertcondition(filteredBear, "Short Entry", "XAUUSD SHORT at {{close}}")
